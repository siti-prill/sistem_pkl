# Salin nilai-nilai ini ke Environment Variables di Railway (bukan file .env)
# - APP_KEY: jalan `php artisan key:generate --show`
# - DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD: dari Railway MySQL service

APP_NAME="Sistem PKL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistempkl-gitdusk-dev.up.railway.app

LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
